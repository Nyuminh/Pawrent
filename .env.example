# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/pawrent

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRE=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=5242880

# AI Chatbot (placeholder – integrate your AI provider)
AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.openai.com/v1/chat/completions

# Commission rates
HOTEL_COMMISSION_RATE=0.15
DEVICE_COMMISSION_RATE=0.10
VET_BOOKING_COMMISSION_RATE=0.10
